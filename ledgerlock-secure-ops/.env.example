# Copy to .env (never commit .env). Everything here is OPTIONAL: the game runs fully offline in demo mode.
# Live Fabric access is OFF unless FABRIC_LIVE_ENABLED=true AND the server-side proxy is running.
# These variables are read ONLY by server/fabricProxy.mjs - never by the browser client.

FABRIC_LIVE_ENABLED=false
FABRIC_PROXY_PORT=8787

# Microsoft Entra app registration (service principal) approved for read-only Fabric access
FABRIC_TENANT_ID=00000000-0000-0000-0000-000000000000
FABRIC_CLIENT_ID=00000000-0000-0000-0000-000000000000
FABRIC_CLIENT_SECRET=replace-me

# Workspace and the pipeline item IDs to monitor (comma separated "label:itemId" pairs)
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_PIPELINE_ITEMS=bronze:00000000-0000-0000-0000-000000000000,silver:00000000-0000-0000-0000-000000000000,gold:00000000-0000-0000-0000-000000000000

# Client-side flag: ask the game to try the proxy (the proxy still enforces FABRIC_LIVE_ENABLED)
VITE_FABRIC_MODE=demo

# JEV (TypeSafe AI "System One" model): optional AI second opinion on decisions. SERVER-SIDE ONLY (api/jev.js and the Vite dev server).
# Set this in Vercel > Project > Settings > Environment Variables (and in a local, git-ignored .env for `npm run dev`).
TYPESAFE_API_KEY=replace-me
# Optional, for tests only: point the proxy at a mock instead of https://api.typesafe.ai/v1/systemone
# TYPESAFE_API_URL=http://127.0.0.1:8799/v1/systemone
